rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Community photo posts: anyone can read, signed-in users can post as
    // themselves, and only the author can delete their own post.
    match /community_treks/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['userId', 'userName', 'lat', 'lng', 'elev', 'time', 'imageUrl', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 80
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && (request.resource.data.elev == null || request.resource.data.elev is number)
        && request.resource.data.time is number
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://vxhvcttfzmikxhjtfntd[.]supabase[.]co/storage/v1/object/public/treks/.*')
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
